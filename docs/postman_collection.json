          "event": [
            {"listen": "prerequest", "script": {"exec": [
              "pm.collectionVariables.set('admin_email', 'admin@example.com');",
              "pm.collectionVariables.set('admin_password', 'AdminPass123!');"
            ], "type": "text/javascript"}},
            {"listen": "test", "script": {"exec": [
              "pm.test('Admin defaults set', function () { pm.expect(pm.collectionVariables.get('admin_email')).to.eql('admin@example.com'); });"
            ], "type": "text/javascript"}}
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
