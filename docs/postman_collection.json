        {"name":"Get Application","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{auth_token}}"}],"url":{"raw":"{{base_url}}/api/applications/{{application_id}}","host":["{{base_url}}"],"path":["api","applications","{{application_id}}"]}}}
