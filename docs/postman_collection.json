            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Staff One\",\n  \"email\": \"staff+{{timestamp}}@example.com\",\n  \"password\": \"Password123!\",\n  \"whatsapp\": \"+1987654321\",\n  \"role\": \"staff\"\n}" }
