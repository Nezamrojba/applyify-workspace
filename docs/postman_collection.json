      "name": "Commission",
      "item": [
        {"name": "Staff: Commission Summary","request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"}],"url":{"raw":"{{base_url}}/api/staff/commission","host":["{{base_url}}"],"path":["api","staff","commission"]}}},
        {"name": "Admin: List Staff Points","request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"}],"url":{"raw":"{{base_url}}/api/admin/staff/points?released=false","host":["{{base_url}}"],"path":["api","admin","staff","points"],"query":[{"key":"released","value":"false"}]}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","const j=pm.response.json(); const first=(j.data&&j.data[0])||null; if(first&&first.id){ pm.collectionVariables.set('point_id', first.id); }"],"type":"text/javascript"}}]},
