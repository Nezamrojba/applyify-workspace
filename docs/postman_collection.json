    {
      "name": "Negative Cases",
      "item": [
        {
          "name": "Register Duplicate Passport",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Dup Student\",\n  \"email\": \"dup+{{timestamp}}@example.com\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"whatsapp\": \"+123\",\n  \"passport_no\": \"P{{timestamp_fixed}}\"\n}" }
          },
          "event": [
            {"listen": "prerequest", "script": {"exec": [
              "if (!pm.collectionVariables.get('passport_fixed')) { pm.collectionVariables.set('passport_fixed', 'P'+Date.now()); }",
              "pm.collectionVariables.set('timestamp_fixed', pm.collectionVariables.get('passport_fixed'));"
            ], "type": "text/javascript"}},
            {"listen": "test", "script": {"exec": [
              "if (pm.response.code === 201) { pm.test('First create allowed', function () { pm.response.to.have.status(201); }); } else { pm.test('Second returns 422', function () { pm.response.to.have.status(422); }); }"
            ], "type": "text/javascript"}}
          ]
        },
        {
          "name": "Login Wrong Password",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"student+{{timestamp}}@example.com\",\n  \"password\": \"WrongPass!\"\n}" }
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test('Returns 422 for invalid credentials', function () { pm.expect([401, 422]).to.include(pm.response.code); });"
            ], "type": "text/javascript"}}
          ]
        },
        {
          "name": "Me Without Token",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api","auth","me"] }
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test('Unauthorized', function () { pm.response.to.have.status(401); });"
            ], "type": "text/javascript"}}
          ]
        },
        {
          "name": "Admin Route With Student Token",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": { "raw": "{{base_url}}/api/admin/users", "host": ["{{base_url}}"], "path": ["api","admin","users"] }
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test('Forbidden', function () { pm.expect([401,403]).to.include(pm.response.code); });"
            ], "type": "text/javascript"}}
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ],
        "type": "text/javascript"
      }
    }
  ],
